# Database (PostgreSQL / Docker / Supabase / Neon)
DATABASE_URL="postgresql://postgres:password@localhost:5432/slotly_db"

# Clerk Authentication (https://clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key_here"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key_here"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Email Notifications (Resend - https://resend.com)
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="Slotly <bookings@yourdomain.com>"
BOOKING_NOTIFICATION_EMAIL="notifications@yourdomain.com"

# Optional Calendar Integration Placeholders (Google Calendar)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
